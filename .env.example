# Copy this file to .env, then add real values locally. Never commit .env.
BAILIAN_API_KEY=
BAILIAN_REGION=cn-beijing
BAILIAN_MODEL=happyhorse-1.1-i2v
BAILIAN_SYNTHESIS_BASE_URL=https://<api-host>/api/v1/services/aigc/video-generation/video-synthesis
BAILIAN_TASK_BASE_URL=https://<api-host>/api/v1/tasks
BAILIAN_TIMEOUT_SECONDS=180
QA_VISION_BASE_URL=https://<api-host>/compatible-mode/v1
QA_VISION_MODEL=qwen-vl-max
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5-air
GLM_TIMEOUT_SECONDS=90
